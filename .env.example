# mock (default, no keys) | bedrock | openai | nebius
LLM_PROVIDER=mock

# Amazon Bedrock. Used when LLM_PROVIDER=bedrock.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Standard AWS credential chain: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, or a role.

# OpenAI-compatible endpoint. LLM_PROVIDER=openai uses these as-is.
# LLM_PROVIDER=nebius defaults the base URL and model below when they are unset.
OPENAI_BASE_URL=https://api.tokenfactory.nebius.com/v1
OPENAI_API_KEY=
NEBIUS_API_KEY=
OPENAI_MODEL=nvidia/Nemotron-3_5-Lightning

# MCP. Leave auth off for the local demo. Turn it on before exposing the server.
MCP_REQUIRE_AUTH=false
MCP_DEMO_TOKEN=talk2build-demo
# Comma-separated browser origins allowed to call /mcp. Localhost is always allowed.
MCP_ALLOWED_ORIGINS=

# Optional override when the Alexa+ client should not call the request host.
# MCP_INTERNAL_URL=http://127.0.0.1:43123/mcp

PORT=43123
