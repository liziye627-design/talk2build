# Who classifies a meeting turn. mock needs no key.
# bedrock | openai | nebius | mock
LLM_PROVIDER=mock

# In-room agent jobs. Leave unset to auto-pick: Bedrock if AWS keys exist,
# otherwise Nebius or OpenAI if those keys exist, otherwise recorded fixtures.
# Set mock to force fixtures even when keys are present.
# TALK2BUILD_AGENT=mock

# Amazon Bedrock. Primary agent backend when AWS credentials are present.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Or AWS_BEARER_TOKEN_BEDROCK for a bearer token.

# Nebius Token Factory. Used when NEBIUS_API_KEY is set and Bedrock is not.
NEBIUS_API_KEY=
# OpenAI-compatible endpoint. OPENAI_API_KEY + OPENAI_BASE_URL also drives a local stub.
OPENAI_BASE_URL=https://api.tokenfactory.nebius.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=nvidia/Nemotron-3_5-Lightning

# How long each agent card stays on a progress step outside tests.
# TALK2BUILD_JOB_PACE_MS=420

# MCP. Leave auth off for the local demo. Turn it on before exposing the server.
MCP_REQUIRE_AUTH=false
MCP_DEMO_TOKEN=talk2build-demo
# Comma-separated browser origins allowed to call /mcp. Localhost is always allowed.
MCP_ALLOWED_ORIGINS=

# Optional override when the Alexa+ client should not call the request host.
# MCP_INTERNAL_URL=http://127.0.0.1:43123/mcp

PORT=43123

# SQLite file and workspace folders. Defaults to ./data
# TALK2BUILD_HOME=./data
