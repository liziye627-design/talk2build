{
  "name": "talk2build",
  "version": "1.0.0",
  "private": true,
  "description": "Task-and-meeting agent. Alexa+ listens, the MCP server does the work, and the files land in the workspace.",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_OPTIONS='--experimental-sqlite' next dev -p 43123 -H 0.0.0.0",
    "build": "next build",
    "start": "NODE_OPTIONS='--experimental-sqlite' next start -p 43123 -H 0.0.0.0",
    "lint": "eslint",
    "test": "NODE_OPTIONS='--experimental-sqlite' vitest run",
    "mcp": "NODE_OPTIONS='--experimental-sqlite' tsx src/server/standalone.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "next": "^15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
